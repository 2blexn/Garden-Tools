@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Відновлення пароля"; }
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon-wrap">
            <i class="bi bi-envelope-paper-heart"></i>
        </div>
        <h1 class="auth-title">Відновлення пароля</h1>
        <p class="auth-subtitle">Введіть email і отримайте посилання для відновлення пароля</p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="auth-field-error mb-3"></div>

            <div class="auth-field">
                <label class="auth-field-label" asp-for="Email">Email <span class="req">*</span></label>
                <input asp-for="Email" class="auth-input" placeholder="your@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <button type="submit" class="auth-submit-btn">Надіслати посилання</button>
        </form>

        <p class="auth-footer-link mt-3 mb-0">
            <a asp-action="Login">Повернутися до входу</a>
        </p>
    </div>
</div>
