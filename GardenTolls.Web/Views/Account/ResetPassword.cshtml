@model ResetPasswordViewModel
@{ ViewData["Title"] = "Новий пароль"; }
@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-icon-wrap">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h1 class="auth-title">Новий пароль</h1>
        <p class="auth-subtitle">Встановіть надійний пароль для вашого облікового запису</p>

        <form asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="auth-field-error mb-3"></div>

            <div class="auth-field">
                <label class="auth-field-label" asp-for="NewPassword">Новий пароль <span class="req">*</span></label>
                <input asp-for="NewPassword" class="auth-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field-label" asp-for="ConfirmPassword">Підтвердження <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="auth-submit-btn">Зберегти пароль</button>
        </form>
    </div>
</div>
