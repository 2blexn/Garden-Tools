@model OrderDetailsViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Чек #{Model.OrderId}";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Чек #@Model.OrderId — Garden Tools</title>
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; padding: 32px; color: #172119; max-width: 720px; margin: 0 auto; }
        h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
        .meta { color: #555; font-size: 0.9rem; margin-bottom: 1.5rem; }
        table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
        th, td { border: 1px solid #ccc; padding: 8px 10px; text-align: left; }
        th { background: #f0f7f4; }
        .total { font-size: 1.15rem; font-weight: 700; margin-top: 1rem; }
        .actions { margin-top: 2rem; display: flex; gap: 12px; flex-wrap: wrap; }
        .btn { padding: 10px 18px; border-radius: 8px; border: none; cursor: pointer; font-size: 0.95rem; text-decoration: none; display: inline-block; }
        .btn-primary { background: #2d5a3f; color: #fff; }
        .btn-outline { background: #fff; border: 1px solid #2d5a3f; color: #2d5a3f; }
        @@media print { .actions { display: none; } }
    </style>
</head>
<body>
    <h1>Чек замовлення #@Model.OrderId</h1>
    <p class="meta">
        @Model.OrderDate.ToString("dd.MM.yyyy HH:mm") · @Model.CustomerName<br />
        @Model.ShippingAddress, @Model.ShippingCity · Оплата: @Model.PaymentMethod (@Model.PaymentStatus)
    </p>

    <table>
        <thead>
            <tr><th>Товар</th><th>К-сть</th><th>Ціна</th><th>Сума</th></tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td>@line.Quantity</td>
                    <td>@line.UnitPrice.ToString("N2") грн</td>
                    <td>@line.LineTotal.ToString("N2") грн</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="total">Разом: @Model.TotalAmount.ToString("N2") грн</p>

    <div class="actions">
        <button type="button" class="btn btn-primary" onclick="window.print()">Друкувати</button>
        <a class="btn btn-outline" asp-action="Receipt" asp-route-id="@Model.OrderId" asp-route-download="true">Завантажити HTML</a>
        <a class="btn btn-outline" asp-action="Success" asp-route-id="@Model.OrderId">Назад</a>
    </div>
</body>
</html>
